# ============================================================
# Myystical_arts — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ─── Server ─────────────────────────────────────────────────
PORT=3000
HTTPS_PORT=3443
NODE_ENV=development

# ─── Admin Credentials ──────────────────────────────────────
# Plain-text password (used only by setup-admin.js to create hash)
# After running `npm run setup`, remove this line from .env
ADMIN_PLAIN_PASSWORD=Myystical@2024

# Bcrypt-hashed password (auto-populated by `npm run setup`)
ADMIN_PASSWORD_HASH=

# Admin username / email for login screen
ADMIN_USERNAME=myystical_admin

# ─── JWT ────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_64_CHARS_MIN
JWT_EXPIRY=2h
JWT_REFRESH_EXPIRY=7d

# ─── Google reCAPTCHA v3 ────────────────────────────────────
# Register your domain at https://www.google.com/recaptcha/admin
# Use v3 (Invisible reCAPTCHA)
RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_KEY_HERE
RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY_HERE
# Set to 'false' to disable CAPTCHA in development
CAPTCHA_ENABLED=false
# Minimum reCAPTCHA v3 score to accept (0.0 - 1.0, recommend 0.5)
RECAPTCHA_MIN_SCORE=0.5

# ─── Rate Limiting ──────────────────────────────────────────
# Requests per window
RATE_LIMIT_PUBLIC=100
RATE_LIMIT_ADMIN=30
RATE_LIMIT_LOGIN=10
# Window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# ─── File Upload ────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# ─── SSL / TLS ──────────────────────────────────────────────
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem

# ─── Instagram ──────────────────────────────────────────────
INSTAGRAM_URL=https://www.instagram.com/myystical__arts?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==
INSTAGRAM_HANDLE=@myystical__arts

# ─── Site ───────────────────────────────────────────────────
SITE_NAME=Myystical_arts
SITE_TAGLINE=Curated Indian Celebrity Gallery
